node_modules
# npm 缓存重定向（不进版本库）
.npm-cache
dist
# 历史遗留的双路构建产物目录（现已不产出；如残留则不入库）
dist-basic/
# 构建前旧产物「改名挪走」的归集（prepare-fonts.mjs 首选清理通道，见该脚本注释）
dist*-trash-*
vite.config.ts.timestamp-*
.scratch
.DS_Store
*.log
# 开发期测试残留（示例画板/联调 payload/临时脚本），不进版本库
demos/

# 本地预览产物（preview-local.bat / vite preview 生成，临时，非源码）
# 覆盖 .preview.err / .preview.out / .preview_pid.txt 三种变体
.preview*

# 说明：internal/ / mcp/ / skills/ / workspace/ / _archive/ 现已位于本仓之外
# （kaiboard/ 为项目工作根，本 app 仓 = kaiboard/app/），无需在此忽略。


# 字体在构建/开发时从 @excalidraw/excalidraw 依赖生成，不进版本库（仓库保持纯文本）
public/fonts/

# favicon 以 data URI 内联进 index.html 与 src/favicon.ts，源 png 不进版本库
public/favicon.png

# 社交分享预览图：GitHub 仓库里不存二进制，发布后在 GitHub Settings 上传
.github/social-preview.png

# 私有工作区双保险：即使将来出现同名目录也绝不提交（internal/ 等实为本仓兄弟目录，见上）
internal/

# Python 字节码（scripts/ 下运行脚本会生成）
__pycache__/
*.pyc
